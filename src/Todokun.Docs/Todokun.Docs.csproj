<Project Sdk="Microsoft.NET.Sdk">

  <!-- md→HTML。Markdig を参照するのはここだけ（要件 5 章）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.css" LogicalName="Todokun.Docs.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
