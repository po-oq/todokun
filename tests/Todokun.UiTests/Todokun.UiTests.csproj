<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Avalonia.Headless.XUnit は xunit v3 を使う（Todokun.Tests は v2 のまま。別のプロジェクトにしてある） -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Todokun\Todokun.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ダイアログの答えを決める作り物は、Todokun.Tests と同じものを使う -->
    <Compile Include="..\Todokun.Tests\FakeUiServices.cs" Link="Shared\FakeUiServices.cs" />
    <Compile Include="..\Todokun.Tests\TempDir.cs" Link="Shared\TempDir.cs" />
  </ItemGroup>

</Project>
