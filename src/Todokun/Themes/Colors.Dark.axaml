<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ダーク -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1F22" />
    <SolidColorBrush x:Key="WindowTextBrush" Color="#D7DAE0" />
    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#1E1F22" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#26282C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2D31" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#33363B" />
    <SolidColorBrush x:Key="RuleBrush" Color="#383B41" />
    <SolidColorBrush x:Key="DimTextBrush" Color="#9AA0AA" />
    <SolidColorBrush x:Key="OutsideTextBrush" Color="#5B606A" />
    <SolidColorBrush x:Key="SundayBrush" Color="#F07178" />
    <SolidColorBrush x:Key="SaturdayBrush" Color="#6CB0FF" />
    <SolidColorBrush x:Key="DotBrush" Color="#58A6FF" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#32353B" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#25416B" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#58A6FF" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#A9D0FF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DF6" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#1E1F22" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#33363B" />
    <SolidColorBrush x:Key="WarnBackgroundBrush" Color="#4A3B12" />
    <SolidColorBrush x:Key="WarnTextBrush" Color="#E3B341" />
</ResourceDictionary>
