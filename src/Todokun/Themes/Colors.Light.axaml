<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 色は画面イメージ（docs/todokun-design.html 3 章）の目安。ライト -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WindowTextBrush" Color="#222222" />
    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#E4E4E4" />
    <SolidColorBrush x:Key="RuleBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="DimTextBrush" Color="#666666" />
    <SolidColorBrush x:Key="OutsideTextBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="SundayBrush" Color="#BB3333" />
    <SolidColorBrush x:Key="SaturdayBrush" Color="#0B63C5" />
    <SolidColorBrush x:Key="DotBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#E8F1FD" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#0B63C5" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#0B63C5" />
    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E3EEFB" />
    <SolidColorBrush x:Key="WarnBackgroundBrush" Color="#FFF4C2" />
    <SolidColorBrush x:Key="WarnTextBrush" Color="#8A5A00" />
</ResourceDictionary>
