<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="todokun-window.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Todokun.Core\Todokun.Core.csproj" />
    <ProjectReference Include="..\Todokun.Docs\Todokun.Docs.csproj" />
    <ProjectReference Include="..\Todokun.Presentation\Todokun.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>todokun</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Todokun</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <ApplicationIcon>todokun-window.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
